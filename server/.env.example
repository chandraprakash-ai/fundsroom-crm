# PostgreSQL connection string (from Supabase, Railway, or local)
# For Supabase: Settings → Database → Connection String → URI (with pgbouncer=true for pooled)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"

# Direct connection URL (required by Prisma migrations with pgbouncer)
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# JWT signing secret — use a long, random 64+ character string in production
JWT_SECRET="change-this-to-a-very-long-random-secret-string"

# Server port (Railway sets this automatically; 5000 is used locally)
PORT=5000
