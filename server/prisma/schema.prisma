// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Roles & Authentication
enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  password          String
  name              String
  role              Role
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockMovements    StockMovementLog[]
  challansCreated   Challan[]
}

// Customer Types & Statuses
enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id           String         @id @default(uuid())
  name         String
  mobile       String
  email        String
  businessName String
  gstNumber    String?        // Optional
  type         CustomerType
  address      String
  status       CustomerStatus
  followUpDate DateTime?      // Optional
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  challans     Challan[]
}

// Product & Inventory
model Product {
  id             String             @id @default(uuid())
  name           String
  sku            String             @unique
  category       String
  unitPrice      Float
  currentStock   Int
  minStockAlert  Int
  location       String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  stockMovements StockMovementLog[]
  challanItems   ChallanItem[]
}

// Stock Movement logs
enum MovementType {
  IN
  OUT
}

model StockMovementLog {
  id              String       @id @default(uuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityChanged Int
  movementType    MovementType
  reason          String
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id])
  timestamp       DateTime     @default(now())
}

// Sales Challan
enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Challan {
  id            String        @id @default(uuid())
  challanNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  totalQuantity Int
  status        ChallanStatus @default(DRAFT)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         ChallanItem[]
}

// Challan Line Items (with Product Snapshot)
model ChallanItem {
  id            String   @id @default(uuid())
  challanId     String
  challan       Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId     String?  // Nullable in case a product is deleted from catalog but challan history needs to remain intact
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity      Int
  priceSnapshot Float    // Crucial: Stores the price at the time of sale
  nameSnapshot  String   // Crucial: Stores the name at the time of sale
  skuSnapshot   String   // Crucial: Stores the SKU at the time of sale
}
